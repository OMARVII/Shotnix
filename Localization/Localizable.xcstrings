    "Zoom Level" : {},
    "Zoom to %@ (key %@)" : {},
    "Zoom — drag to move, drag an edge to resize, click to edit" : {},
    "a table" : {
      "comment" : "Listed with links and email addresses the recognized text holds",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eine Tabelle"
          }
        },
        "fr" : {
