        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该视频为空"
          }
        }
      }
    },
    "That window closed before recording could start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster wurde geschlossen, bevor die Aufzeichnung beginnen konnte."
