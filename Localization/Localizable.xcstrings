    "This replaces all %lld caption lines, including any you edited or typed, with a new transcript in %@." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dadurch wird %lld Untertitelzeile – auch wenn du sie bearbeitet oder getippt hast – durch ein neues Transkript auf %@ ersetzt."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dadurch werden alle %lld Untertitelzeilen – auch bearbeitete oder getippte – durch ein neues Transkript auf %@ ersetzt."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This replaces %lld caption line, even if you edited or typed it, with a new transcript in %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This replaces all %lld caption lines, including any you edited or typed, with a new transcript in %@."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cela remplace %lld ligne de sous-titres, même si vous l’avez modifiée ou saisie, par une nouvelle transcription en %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cela remplace les %lld lignes de sous-titres, y compris celles que vous avez modifiées ou saisies, par une nouvelle transcription en %@."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Все строки субтитров (%lld), включая измененные и введенные вами, будут заменены новой расшифровкой на языке «%@»."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Все строки субтитров (%lld), включая измененные и введенные вами, будут заменены новой расшифровкой на языке «%@»."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Все строки субтитров (%lld), включая измененные и введенные вами, будут заменены новой расшифровкой на языке «%@»."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Все строки субтитров (%lld), включая измененные и введенные вами, будут заменены новой расшифровкой на языке «%@»."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会用新的%2$@文字稿替换全部 %1$lld 行字幕，包括你编辑或输入过的行。"
          }
        }
      }
    },
    "This video is copy-protected and can't be exported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Video ist kopiergeschützt und kann nicht exportiert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vidéo est protégée contre la copie et ne peut pas être exportée."
