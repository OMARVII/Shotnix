    "Open System Settings → Keyboard → Keyboard Shortcuts → Screenshots and turn off the screenshot shortcuts manually." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne „Systemeinstellungen“ → „Tastatur“ → „Tastaturkurzbefehle“ → „Bildschirmfotos“ und deaktiviere die Kurzbefehle für Bildschirmfotos dort von Hand."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Réglages Système → Clavier → Raccourcis clavier → Captures d’écran et désactivez manuellement les raccourcis de capture."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Системные настройки → Клавиатура → Сочетания клавиш → Снимки экрана и выключите сочетания клавиш для снимков экрана вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开“系统设置”→“键盘”→“键盘快捷键”→“截屏”，然后手动关闭截屏快捷键。"
          }
