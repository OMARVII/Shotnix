            "value" : "Enregistrements"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制内容"
          }
        }
      }
    },
    "Recordings in the Trash or on a drive that isn't plugged in keep their data. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen im Papierkorb oder auf einem nicht angeschlossenen Laufwerk behalten ihre Daten. Dies kann nicht widerrufen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements placés dans la corbeille ou sur un disque non branché conservent leurs données. Cette action est irréversible."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "废纸篓中或未连接磁盘上的录制内容会保留其数据。此操作无法撤销。"
          }
        }
      }
    },
    "Recordings made with Shotnix capture the pointer so it can be smoothed, resized, and hidden." : {},
    "Records %@ × %@ pixels (%@ × %@ points)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet %@ × %@ Pixel auf (%@ × %@ Punkte)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre %@ × %@ pixels (%@ × %@ points)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制 %@ × %@ 像素（%@ × %@ 点）"
          }
        }
      }
    },
    "Records the pointer separately, so the editor can smooth it, resize it, and keep it crisp when zoomed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet den Zeiger separat auf, damit der Editor ihn glätten, skalieren und beim Zoomen scharf halten kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre le pointeur séparément, pour que l’éditeur puisse le lisser, le redimensionner et le garder net en cas de zoom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独录制指针，以便编辑器平滑指针、调整其大小，并在缩放时保持清晰。"
          }
        }
      }
    },
    "Recovered your interrupted recording “%@”. Click to open it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine unterbrochene Aufnahme „%@“ wurde wiederhergestellt. Klicke, um sie zu öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre enregistrement interrompu « %@ » a été récupéré. Cliquez pour l’ouvrir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
