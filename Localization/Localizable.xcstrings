    },
    "A file with that name is in the way. Pick another name and export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei mit diesem Namen ist im Weg. Wähle einen anderen Namen und exportiere erneut."
          }
        },
        "fr" : {
