          }
        }
      }
    },
    "Microphone access is off, so this recording has no mic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist deaktiviert, daher hat diese Aufnahme keinen Mikrofonton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro est désactivé : cet enregistrement n’aura pas de son du micro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问权限已关闭，因此此录制内容没有麦克风声音。"
          }
        }
      }
    },
    "Microphone access is off. Allow Shotnix in System Settings → Privacy & Security → Microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist deaktiviert. Erlaube Shotnix in Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro est désactivé. Autorisez Shotnix dans Réglages Système → Confidentialité et sécurité → Micro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问权限已关闭。请在“系统设置”→“隐私与安全性”→“麦克风”中允许 Shotnix。"
          }
        }
      }
    },
    "Microphone disconnected. Now recording from %@." : {
      "comment" : "The microphone now used",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon getrennt. Die Aufzeichnung läuft jetzt über „%@“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micro déconnecté. L’enregistrement utilise maintenant « %@ »."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风已断开连接。现在使用“%@”录音。"
          }
        }
      }
    },
    "Microphone disconnected. The recording continues without it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon getrennt. Die Aufzeichnung läuft ohne Mikrofon weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Micro déconnecté. L’enregistrement continue sans lui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
