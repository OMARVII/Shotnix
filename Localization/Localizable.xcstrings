          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此视频已不存在"
          }
        }
      }
    },
    "This video was recorded with your camera, but “%@” isn't in %@ anymore. Put it back there and open the video again to get the camera bubble back." : {
      "comment" : "The camera file's name, then the folder it was in",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Video wurde mit deiner Kamera aufgezeichnet, aber „%@“ ist nicht mehr in %@. Lege die Datei zurück und öffne das Video erneut, um die Kamerablase zurückzubekommen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vidéo a été enregistrée avec votre caméra, mais « %@ » ne se trouve plus dans %@. Remettez-le à cet endroit et rouvrez la vidéo pour retrouver la bulle de caméra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это видео записано с камерой, но файла «%@» больше нет в папке %@. Верните его туда и снова откройте видео, чтобы вернуть окошко камеры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此视频录制时使用了摄像头，但“%@”已不在 %@ 中。请将它放回原处并重新打开视频，即可恢复摄像头气泡。"
          }
        }
      }
    },
    "Three quick steps and you're capturing." : {
      "localizations" : {
