          "stringUnit" : {
            "state" : "translated",
            "value" : "Это видео защищено от копирования, и его нельзя экспортировать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此视频受复制保护，无法导出。"
