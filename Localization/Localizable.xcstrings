    "Thanks for watching" : {
      "comment" : "Default outro card title, which the user edits",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke fürs Zuschauen"
          }
        },
        "fr" : {
