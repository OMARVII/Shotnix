        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette partie n’est qu’un carton de titre — incluez un moment de la vidéo pour l’exporter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这部分只有标题卡 — 请包含视频的一部分才能导出。"
          }
        }
      }
    },
    "That part of the timeline is only a title card. Include a moment of the video in the range, then export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Teil der Zeitleiste ist nur eine Titelkarte. Nimm einen Moment des Videos in den Bereich auf und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette partie de la timeline n’est qu’un carton de titre. Incluez un moment de la vidéo dans la plage, puis exportez à nouveau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
