          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问权限已关闭，因此本次录制不含麦克风声音。"
          }
        }
      }
    },
    "Microphone access is off. Allow Shotnix in System Settings → Privacy & Security → Microphone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist deaktiviert. Erlaube Shotnix unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Mikrofon“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro est désactivé. Autorisez Shotnix dans Réglages Système → Confidentialité et sécurité → Micro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к микрофону выключен. Разрешите его для Shotnix в разделе Системные настройки → Конфиденциальность и безопасность → Микрофон."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问权限已关闭。请在“系统设置”→“隐私与安全性”→“麦克风”中允许 Shotnix。"
          }
        }
      }
    },
    "Microphone disconnected. Now recording from %@." : {
