    "Clean Up" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufräumen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettoyer"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
