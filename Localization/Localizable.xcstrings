    "Keeping 30 days removes %lld older captures from History now. This can't be undone." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mit „30 Tage“ wird jetzt %lld älteres Bildschirmfoto aus dem Verlauf entfernt. Dies kann nicht widerrufen werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mit „30 Tage“ werden jetzt %lld ältere Bildschirmfotos aus dem Verlauf entfernt. Dies kann nicht widerrufen werden."
