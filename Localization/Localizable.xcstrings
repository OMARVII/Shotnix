    "Records the pointer separately, so the editor can smooth it, resize it, and keep it crisp when zoomed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet den Zeiger separat auf, damit der Editor ihn glätten, skalieren und beim Zoomen scharf halten kann."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre le pointeur séparément, pour que l’éditeur puisse le lisser, le redimensionner et le garder net en cas de zoom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单独录制指针，以便编辑器平滑指针、调整其大小，并在缩放时保持清晰。"
          }
        }
      }
    },
