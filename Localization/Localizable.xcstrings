    "Done (Esc)" : {},
    "Double-click to show the recording in Finder" : {},
    "Drag one of them on the timeline to move them all together; ⌫ removes them all. ⇧- or ⌘-click adds or takes one out." : {},
    "Drag the block on the Camera lane to move it, or its edges to change how long it lasts. Each change eases in and out." : {},
    "Drag the frame on the preview to aim; drag its corners to zoom in or out." : {},
    "Drag to change where this clip ends" : {},
    "Drag to change where this clip starts" : {},
    "Drag to move this clip to another place in the video" : {},
    "Drag to move where the arrow starts" : {},
    "Drag to move; drag a corner to resize" : {},
    "Drag to point the arrow" : {},
    "Draw with the selected tool. Tool shortcuts: V select, A arrow, R rectangle, T text, O callout, H highlighter, B blur, P pixelate, S spotlight, C crop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem ausgewählten Werkzeug zeichnen. Kurzbefehle: V Auswählen, A Pfeil, R Rechteck, T Text, O Sprechblase, H Textmarker, B Weichzeichnen, P Verpixeln, S Fokus, C Beschneiden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessinez avec l’outil sélectionné. Raccourcis des outils : V sélectionner, A flèche, R rectangle, T texte, O bulle, H surligneur, B flouter, P pixéliser, S projecteur, C rogner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用所选工具绘制。工具快捷键：V 选择、A 箭头、R 矩形、T 文字、O 标注气泡、H 荧光笔、B 模糊、P 像素化、S 聚光灯、C 裁剪。"
          }
        }
      }
    },
    "Drawing" : {
