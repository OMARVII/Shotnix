    "Cards use your background, and the timeline grows to fit them. The “Made with Shotnix” end card is separate — it's in the export options." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karten nutzen deinen Hintergrund, und die Zeitleiste wird für sie länger. Die Endkarte „Made with Shotnix“ ist davon getrennt – du findest sie in den Exportoptionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartons utilisent votre arrière-plan, et la timeline s’allonge pour les accueillir. L’écran de fin « Made with Shotnix » est à part — il se trouve dans les options d’exportation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
