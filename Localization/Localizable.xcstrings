    "Shotnix can't save to that folder. Pick another place, like Desktop or Movies, and export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotnix kann nicht in diesem Ordner sichern. Wähle einen anderen Ort, etwa „Schreibtisch“ oder „Filme“, und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotnix ne peut pas enregistrer dans ce dossier. Choisissez un autre emplacement, comme Bureau ou Vidéos, puis exportez à nouveau."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotnix не может сохранить файл в эту папку. Выберите другое место, например «Рабочий стол» или «Фильмы», и экспортируйте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotnix 无法存储到该文件夹。请选择其他位置（如“桌面”或“影片”），然后重新导出。"
          }
        }
      }
    },
    "Shotnix can't write to the save folder. Choose another one in Settings → Screenshots." : {
      "comment" : "Names Shotnix's Settings pane where the save folder is chosen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotnix kann nicht in den Zielordner schreiben. Wähle einen anderen unter „Einstellungen“ → „Bildschirmfotos“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotnix ne peut pas écrire dans le dossier d’enregistrement. Choisissez-en un autre dans Réglages → Captures."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shotnix не может записывать в папку для сохранения. Выберите другую в разделе Настройки → Снимки экрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
