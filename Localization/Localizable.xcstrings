    "Speech recognition is turned off for Shotnix in System Settings → Privacy & Security → Speech Recognition. Turn it on, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung ist für Shotnix unter „Systemeinstellungen“ → „Datenschutz & Sicherheit“ → „Spracherkennung“ deaktiviert. Aktiviere sie und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
