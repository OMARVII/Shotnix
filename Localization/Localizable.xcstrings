    "Opens its title and length in Style" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet Titel und Länge in „Stil“"
          }
        },
        "fr" : {
          "stringUnit" : {
