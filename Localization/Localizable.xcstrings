    "%@ can't be transcribed on this Mac without sending your voice to a server. To add it, turn on Dictation for %@ in System Settings → Keyboard, or pick another language." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann auf diesem Mac nicht transkribiert werden, ohne deine Stimme an einen Server zu senden. Aktiviere dazu das Diktat für %@ unter „Systemeinstellungen“ → „Tastatur“ oder wähle eine andere Sprache."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue %@ ne peut pas être transcrite sur ce Mac sans envoyer votre voix à un serveur. Pour l’ajouter, activez la dictée (%@) dans Réglages Système → Clavier, ou choisissez une autre langue."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 无法在不将你的声音发送到服务器的情况下转录%@。若要添加，请在“系统设置”→“键盘”中打开%@的听写，或选择其他语言。"
          }
