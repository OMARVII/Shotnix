            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Avec « 30 jours », %lld capture plus ancienne sera supprimée de l’historique dès maintenant. Cette action est irréversible."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Avec « 30 jours », %lld captures plus anciennes seront supprimées de l’historique dès maintenant. Cette action est irréversible."
