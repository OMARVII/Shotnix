    },
    "That drive is read-only. Pick another place to save, then export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Laufwerk ist schreibgeschützt. Wähle einen anderen Ort zum Sichern und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce disque est en lecture seule. Choisissez un autre emplacement, puis exportez à nouveau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该磁盘为只读。请选择其他存储位置，然后重新导出。"
          }
        }
      }
    },
    "That part is only a title card — include a moment of the video to export it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Teil ist nur eine Titelkarte – nimm einen Moment des Videos mit auf, um ihn zu exportieren."
