    "That display isn't available anymore." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bildschirm ist nicht mehr verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran n’est plus disponible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот дисплей больше недоступен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该显示器已不可用。"
          }
        }
      }
    },
    "That display or window isn't available anymore." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bildschirm oder dieses Fenster ist nicht mehr verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran ou cette fenêtre n’est plus disponible."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот дисплей или окно больше недоступны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该显示器或窗口已不可用。"
          }
        }
      }
    },
    "That drive is read-only. Pick another place to save, then export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Laufwerk ist schreibgeschützt. Wähle einen anderen Ort zum Sichern und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce disque est en lecture seule. Choisissez un autre emplacement, puis exportez à nouveau."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот диск доступен только для чтения. Выберите другое место для сохранения и экспортируйте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该磁盘为只读。请选择其他存储位置，然后重新导出。"
          }
        }
      }
    },
    "That part is only a title card — include a moment of the video to export it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Teil ist nur eine Titelkarte – nimm einen Moment des Videos mit auf, um ihn zu exportieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette partie n’est qu’un carton de titre — incluez un moment de la vidéo pour l’exporter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот фрагмент — только титр. Включите в него часть видео, чтобы экспортировать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这部分只有标题卡 — 请包含视频的一部分才能导出。"
          }
        }
      }
    },
    "That part of the timeline is only a title card. Include a moment of the video in the range, then export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Teil der Zeitleiste ist nur eine Titelkarte. Nimm einen Moment des Videos in den Bereich auf und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette partie de la timeline n’est qu’un carton de titre. Incluez un moment de la vidéo dans la plage, puis exportez à nouveau."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот участок шкалы времени — только титр. Включите в диапазон часть видео и экспортируйте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间线的这部分只有标题卡。请在范围中包含视频的一部分，然后重新导出。"
          }
        }
      }
    },
    "That video is empty" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Video ist leer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vidéo est vide"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это видео пустое"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该视频为空"
          }
        }
      }
    },
    "That window closed before recording could start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster wurde geschlossen, bevor die Aufzeichnung beginnen konnte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre s’est fermée avant le début de l’enregistrement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окно закрылось до начала записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口在录制开始前已关闭。"
          }
        }
      }
    },
    "The camera couldn't start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera konnte nicht gestartet werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de démarrer la caméra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить камеру."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法启动摄像头。"
          }
        }
      }
    },
    "The camera keeps your cursor in view and glides after it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera behält deinen Zeiger im Bild und gleitet ihm nach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caméra garde votre pointeur dans le cadre et le suit en douceur."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера держит указатель в кадре и плавно следует за ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镜头会让指针保持在画面中，并平滑地跟随它。"
          }
        }
      }
    },
    "The camera stopped. The recording continues without it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wurde gestoppt. Die Aufzeichnung läuft ohne Kamera weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caméra s’est arrêtée. L’enregistrement continue sans elle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера остановилась. Запись продолжается без нее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摄像头已停止。录制将继续，但不含摄像头画面。"
          }
        }
      }
    },
    "The cursor is part of this video" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zeiger ist Teil dieses Videos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pointeur fait partie de cette vidéo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указатель — часть этого видео"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针已录入此视频"
          }
        }
      }
    },
    "The export carries on in the background (Esc)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export läuft im Hintergrund weiter (Esc)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exportation se poursuit en arrière-plan (Échap)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт продолжится в фоне (Esc)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出会在后台继续（Esc）"
          }
        }
      }
    },
    "The export stopped unexpectedly (%@). Try again — if it keeps happening, export at a lower resolution or in H.264." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export wurde unerwartet beendet (%@). Versuche es erneut – wenn das weiterhin passiert, exportiere mit niedrigerer Auflösung oder in H.264."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exportation s’est arrêtée de façon inattendue (%@). Réessayez — si le problème persiste, exportez à une résolution plus basse ou en H.264."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт неожиданно остановился (%@). Повторите попытку — если ошибка повторится, экспортируйте в более низком разрешении или в H.264."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出意外停止（%@）。请重试 — 如果问题仍然存在，请以较低分辨率或 H.264 格式导出。"
          }
        }
      }
    },
    "The menu bar icon is Shotnix's main entry point. While it is hidden, open Shotnix again from Finder, Launchpad, or Spotlight to bring these Preferences back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über das Symbol in der Menüleiste erreichst du Shotnix. Solange es ausgeblendet ist, öffne Shotnix erneut über den Finder, das Launchpad oder Spotlight, um diese Einstellungen wieder aufzurufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’icône de la barre des menus est le principal point d’accès à Shotnix. Tant qu’elle est masquée, ouvrez de nouveau Shotnix depuis le Finder, le Launchpad ou Spotlight pour retrouver ces réglages."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значок в строке меню — основной способ открыть Shotnix. Пока он скрыт, чтобы вернуться к этим настройкам, снова откройте Shotnix из Finder, Launchpad или Spotlight."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏图标是 Shotnix 的主要入口。隐藏后，可从“访达”、“启动台”或“聚焦”再次打开 Shotnix 来重新显示这些设置。"
          }
        }
      }
    },
    "The microphone couldn't start, so this recording has no mic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon konnte nicht gestartet werden, daher hat diese Aufnahme keinen Mikrofonton."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro n’a pas pu démarrer : cet enregistrement n’aura pas de son du micro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось запустить микрофон, поэтому запись идет без микрофона."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风无法启动，因此本次录制不含麦克风声音。"
          }
        }
      }
    },
    "The microphone stopped working. The recording continues without it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon funktioniert nicht mehr. Die Aufzeichnung läuft ohne Mikrofon weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro a cessé de fonctionner. L’enregistrement continue sans lui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон перестал работать. Запись продолжается без него."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风已停止工作。录制将继续，但不含麦克风声音。"
          }
        }
      }
    },
    "The picture's file is gone — choose it again with Replace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bilddatei fehlt – wähle sie mit „Ersetzen“ erneut aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de l’image a disparu — choisissez-le à nouveau avec Remplacer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл изображения пропал — выберите его снова с помощью «Заменить»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图片文件已不存在 — 请使用“替换”重新选择。"
          }
        }
      }
    },
    "The recording couldn't be finished — saved the first %@." : {
      "comment" : "How much of the recording was kept, like “42 s” or “2:05”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme konnte nicht abgeschlossen werden – die ersten %@ sind gesichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement n’a pas pu être finalisé — le début (%@) a été sauvegardé."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось завершить запись — сохранены первые %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制无法完成 — 已存储前 %@。"
          }
        }
      }
    },
    "The recording's file can't be found — it may have been moved or deleted. Put it back and export again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei der Aufnahme wurde nicht gefunden – sie wurde eventuell bewegt oder gelöscht. Lege sie zurück und exportiere erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de l’enregistrement est introuvable — il a peut-être été déplacé ou supprimé. Remettez-le en place, puis exportez à nouveau."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл записи не найден — возможно, его переместили или удалили. Верните его на место и экспортируйте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到录制内容的文件 — 它可能已被移动或删除。请将它放回原处，然后重新导出。"
          }
        }
      }
    },
    "The save panel did not return a destination. Please try saving again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sichern-Fenster hat keinen Speicherort zurückgegeben. Bitte versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La zone de dialogue d’enregistrement n’a renvoyé aucune destination. Veuillez réessayer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Окно сохранения не вернуло место назначения. Попробуйте сохранить еще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储面板未返回存储位置。请再次尝试存储。"
          }
        }
      }
    },
    "The screenshot has no image data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bildschirmfoto enthält keine Bilddaten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture ne contient aucune donnée d’image."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В снимке экрана нет данных изображения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截屏不含图像数据。"
          }
        }
      }
    },
    "The selected file has no video track. Choose a video file instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählte Datei hat keine Videospur. Wähle stattdessen eine Videodatei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier sélectionné ne contient pas de piste vidéo. Choisissez plutôt un fichier vidéo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В выбранном файле нет видеодорожки. Выберите видеофайл."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选文件没有视频轨道。请改为选择视频文件。"
          }
        }
      }
    },
    "The selection stays on screen to adjust — drag its edges, nudge it with the arrow keys, then press Return. Hold ⇧ as you release to capture right away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl bleibt zum Anpassen auf dem Bildschirm – ziehe an den Rändern, verschiebe sie mit den Pfeiltasten und drücke dann den Zeilenschalter. Halte beim Loslassen ⇧ gedrückt, um sofort aufzunehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sélection reste à l’écran pour être ajustée — faites glisser ses bords, déplacez-la avec les touches fléchées, puis appuyez sur Retour. Maintenez ⇧ en relâchant pour capturer immédiatement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделение остается на экране для настройки: перетяните его края, сдвиньте его клавишами со стрелками, затем нажмите Return. Удерживайте ⇧ при отпускании, чтобы сделать снимок сразу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选区会留在屏幕上供你调整 — 拖移边缘、用方向键微调，然后按下 Return 键。松开时按住 ⇧ 可立即截屏。"
          }
        }
      }
    },
    "The song is shorter than the video" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Song ist kürzer als das Video"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le morceau est plus court que la vidéo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Песня короче видео"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌曲比视频短"
          }
        }
      }
    },
    "The song's file is gone — choose it again with Replace." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Songdatei fehlt – wähle sie mit „Ersetzen“ erneut aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier du morceau a disparu — choisissez-le à nouveau avec Remplacer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
