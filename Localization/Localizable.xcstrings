        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un outro « Made with Shotnix » de 2 secondes sur votre arrière-plan — votre propre carton de fin se trouve dans Style"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двухсекундная концовка «Made with Shotnix» на вашем фоне — собственный финальный титр находится во вкладке «Стиль»"
          }
        },
        "zh-Hans" : {
