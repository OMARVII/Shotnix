    "Menu bar is full, so macOS hid the Shotnix icon — %@ still captures. Click here for the menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Menüleiste ist voll, deshalb hat macOS das Shotnix-Symbol ausgeblendet – %@ nimmt trotzdem auf. Klicke hier für das Menü."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre des menus est pleine : macOS a masqué l’icône de Shotnix — %@ capture toujours. Cliquez ici pour ouvrir le menu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строка меню заполнена, поэтому macOS скрыла значок Shotnix — %@ по-прежнему делает снимки. Нажмите здесь, чтобы открыть меню."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏已满，macOS 隐藏了 Shotnix 图标 — 按 %@ 仍可截屏。点按此处打开菜单。"
          }
        }
      }
    },
    "Menu bar is full, so macOS hid the Shotnix icon — your shortcuts still work. Click here for the menu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Menüleiste ist voll, deshalb hat macOS das Shotnix-Symbol ausgeblendet – deine Kurzbefehle funktionieren weiterhin. Klicke hier für das Menü."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre des menus est pleine : macOS a masqué l’icône de Shotnix — vos raccourcis fonctionnent toujours. Cliquez ici pour ouvrir le menu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строка меню заполнена, поэтому macOS скрыла значок Shotnix — ваши сочетания клавиш по-прежнему работают. Нажмите здесь, чтобы открыть меню."
          }
        },
        "zh-Hans" : {
