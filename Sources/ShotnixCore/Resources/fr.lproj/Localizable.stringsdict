			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld annotation, sélection : %@</string>
			<key>other</key>
			<string>%lld annotations, sélection : %@</string>
		</dict>
	</dict>
