		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Avec « 30 jours », %lld capture plus ancienne sera supprimée de l’historique dès maintenant. Cette action est irréversible.</string>
			<key>other</key>
			<string>Avec « 30 jours », %lld captures plus anciennes seront supprimées de l’historique dès maintenant. Cette action est irréversible.</string>
		</dict>
	</dict>
