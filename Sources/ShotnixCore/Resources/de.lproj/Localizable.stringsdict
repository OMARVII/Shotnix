<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Tag</string>
			<key>other</key>
			<string>%lld Tage</string>
		</dict>
	</dict>
	<key>%lld saved captures · drag any card to Finder · right-click for more actions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld gesichertes Bildschirmfoto · Karten in den Finder ziehen · Rechtsklick für mehr</string>
			<key>other</key>
			<string>%lld gesicherte Bildschirmfotos · Karten in den Finder ziehen · Rechtsklick für mehr</string>
		</dict>
	</dict>
	<key>%lld screenshots deleted — click or press ⌘Z to undo</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Bildschirmfoto gelöscht – klicken oder ⌘Z drücken zum Widerrufen</string>
			<key>other</key>
			<string>%lld Bildschirmfotos gelöscht – klicken oder ⌘Z drücken zum Widerrufen</string>
		</dict>
	</dict>
	<key>Last %lld captures</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Letztes Bildschirmfoto</string>
			<key>other</key>
			<string>Letzte %lld Bildschirmfotos</string>
		</dict>
	</dict>
</dict>
</plist>
